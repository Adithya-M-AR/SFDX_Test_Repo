<?xml version="1.0" encoding="UTF-8"?>
<DataCalcInsightTemplate xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <builderExpression xsi:nil="true"/>
    <creationType>Custom</creationType>
    <dataspaceName>Retail360</dataspaceName>
    <dataspacePrefix>Tes</dataspacePrefix>
    <definitionType>CALCULATED_METRIC</definitionType>
    <description xsi:nil="true"/>
    <developerName>Tes_Lifetime_Value</developerName>
    <dialect>ANSI_SQL</dialect>
    <expression>SELECT
  Tes_Individual__dlm.Id__c AS IndividualId__c,
  SUM(Tes_SalesOrder__dlm.GrandTotalAmount__c) AS LifetimeValue__c
FROM Tes_SalesOrder__dlm
JOIN Tes_Individual__dlm
  ON Tes_Individual__dlm.Id__c = Tes_SalesOrder__dlm.PayerAccountId__c
GROUP BY Tes_Individual__dlm.Id__c</expression>
    <masterLabel>Lifetime_Value</masterLabel>
    <scheduleInterval>0</scheduleInterval>
    <sourceObjectDevName>Tes_Lifetime_Value</sourceObjectDevName>
    <templateVersion>1</templateVersion>
</DataCalcInsightTemplate>
